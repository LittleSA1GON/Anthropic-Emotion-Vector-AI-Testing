{
  "version": "work-queue-v1",
  "principles": [
    "read files by task",
    "patch instead of rewrite",
    "run narrow tests first",
    "no fabricated empirical results",
    "record every GPU run's provenance"
  ],
  "tasks": [
    {
      "id": "T00",
      "priority": 0,
      "status": "complete_cpu",
      "objective": "Check baseline source/tests and regenerate self-contained notebook",
      "entry": [
        "AGENTS.md",
        "scripts/build_notebook.py"
      ],
      "acceptance": [
        "pytest full suite passes",
        "notebook reconstructs all source on CPU",
        "case matrix=18"
      ],
      "commands": [
        "python -m pytest -q",
        "python scripts/build_notebook.py"
      ]
    },
    {
      "id": "T01",
      "priority": 1,
      "status": "complete_gpu",
      "objective": "Validate real single-model FP16 capture and baseline generations on available GPU",
      "entry": [
        "mm_emotion/hf_backend.py",
        "mm_emotion/multi_model.py"
      ],
      "acceptance": [
        "real generations nonempty",
        "captures finite",
        "record real checkpoint/precision/device",
        "zero hook leftover"
      ],
      "commands": [
        "python -m mm_emotion.cli doctor",
        "python -m mm_emotion.multi_model --models qwen05 --mode infer --out runs/real_qwen05_infer.json"
      ]
    },
    {
      "id": "T02",
      "priority": 2,
      "status": "complete_gpu_ungraded",
      "objective": "Run 18-case real activation model matrix with independent baseline vectors",
      "entry": [
        "mm_emotion/course_tests.py",
        "course/18_test_cases.csv"
      ],
      "acceptance": [
        "18 distinct cases per model",
        "ungraded until thresholds approved",
        "zero-norm cases labeled unscorable",
        "run metadata saved"
      ],
      "commands": [
        "python -m mm_emotion.multi_model --models qwen05 --mode matrix --layer 5 --out runs/real_qwen05_matrix.json"
      ]
    },
    {
      "id": "T03",
      "priority": 3,
      "status": "complete_gpu",
      "objective": "Finish per-model vector discovery, native vector selection, controlled +/0/- sweeps, repeated seeds and A/B export",
      "entry": [
        "mm_emotion/workbench.py",
        "mm_emotion/multi_model.py",
        "pages/1_Multi_Model_Experiments.py"
      ],
      "acceptance": [
        "never transfer vectors across model IDs implicitly",
        "zero baseline always included",
        "vector paths and SHA256 recorded",
        "hook isolation tests"
      ]
    },
    {
      "id": "T04",
      "priority": 4,
      "status": "complete",
      "objective": "Improve local Streamlit and Kaggle widgets for model/dataset/layer/strength controls",
      "entry": [
        "app_emotion.py",
        "pages/1_Multi_Model_Experiments.py",
        "mm_emotion/course_notebook_ui.py"
      ],
      "acceptance": [
        "typed prompts + CSV import",
        "two+ checkpoints sequential",
        "results visible and downloadable",
        "upload validation"
      ]
    },
    {
      "id": "T05",
      "priority": 5,
      "status": "complete_portable_pdf_word_layout_unverified",
      "objective": "Finish CMPE187 Deliverable #2 automation and native editable diagrams",
      "entry": [
        "mm_emotion/drawio.py",
        "mm_emotion/course_report.py",
        "course/drawio/"
      ],
      "acceptance": [
        "Sections 1-4 plus 2.1-2.4/3.1-3.3/4.1-4.3",
        "4 editable draw.io pages",
        "18 cases + expected outputs",
        "stats based only on real results",
        "DOCX and PDF visually reviewed"
      ]
    },
    {
      "id": "T06",
      "priority": 6,
      "status": "pending",
      "objective": "Calibrate validity bounds from independent validation split with course instructor approval",
      "entry": [
        "mm_emotion/course_tests.py",
        "course/18_test_cases.csv"
      ],
      "acceptance": [
        "original source bound retained",
        "approved policy explicitly versioned",
        "no test-split tuning",
        "neutral label semantics documented"
      ]
    },
    {
      "id": "T07",
      "priority": 7,
      "status": "complete_gpu_pilot",
      "objective": "Compare same-model FP16 vs NF4, and cautiously test a second model family",
      "entry": [
        "mm_emotion/pipeline.py",
        "mm_emotion/multi_model.py"
      ],
      "acceptance": [
        "same prompts/layers/checkpoint for precision comparisons",
        "separate baselines for different model families",
        "latency/VRAM/error evidence"
      ]
    },
    {
      "id": "T08",
      "priority": 8,
      "status": "pending_optional",
      "objective": "Attempt genuine IBM MIA on Kaggle T4 only after HF experiments pass",
      "entry": [
        "mm_emotion/mia_backend.py",
        "scripts/install_mia_kaggle.sh"
      ],
      "acceptance": [
        "document installation reproducibly",
        "nonempty Q/K or hidden-state captures",
        "no claim of support unless it runs"
      ]
    },
    {
      "id": "T09",
      "priority": 9,
      "status": "blocked_original_source",
      "objective": "Optional direct integration into Model Mountain v4 after obtaining original archive",
      "entry": [
        "integrations/README.md",
        "scripts/install_into_model_mountain.py"
      ],
      "acceptance": [
        "original gateway untouched",
        "explicit compatible adapter",
        "v4 tests pass before committing"
      ]
    },
    {
      "id": "T10",
      "priority": 10,
      "status": "complete_release_measured_ungraded",
      "objective": "Final real-data report, reproducibility evidence, PDF render/visual check, release ZIP",
      "entry": [
        "mm_emotion/course_report.py",
        "work_handoff/PROGRESS.json"
      ],
      "acceptance": [
        "no fabricated runs",
        "all deliverables linked",
        "CPU and GPU validation separated"
      ]
    },
    {
      "id": "T11",
      "priority": 11,
      "status": "complete_gpu",
      "objective": "Use each researcher\u2019s Kaggle API account from the UI for private experiments and measured activation visualizations",
      "entry": [
        "mm_emotion/kaggle_runner.py",
        "mm_emotion/remote_experiment.py",
        "pages/3_Kaggle_Experiment_Lab.py"
      ],
      "acceptance": [
        "session-only API tokens",
        "private account-specific jobs",
        "mandatory zero control",
        "post-intervention model snapshots",
        "real T4 end-to-end check"
      ]
    },
    {
      "id": "T12",
      "priority": 12,
      "status": "complete",
      "objective": "Apply the user-supplied StyleKit guide to the experiment UI",
      "entry": [
        "mm_emotion/ui_theme.py",
        ".streamlit/config.toml",
        "mm_emotion/activation_view.py"
      ],
      "acceptance": [
        "clear experiment/results hierarchy",
        "responsive controls",
        "accessible focus and contrast",
        "readable animation controls"
      ]
    },
    {
      "id": "T13",
      "priority": 13,
      "status": "complete_gpu",
      "objective": "Integrate model links, all-test CSV, Kaggle account, measured emotion gauges, subtraction animation and mixed-vector inference",
      "entry": [
        "mm_emotion/experiment_inputs.py",
        "mm_emotion/integrated_experiment.py",
        "mm_emotion/integrated_ui.py",
        "mm_emotion/experiment_figures.py"
      ],
      "acceptance": [
        "model preflight and real hooks",
        "downloadable CSV with independent train/test rows",
        "multi-emotion scores and gauges",
        "real native-vector reuse and zero controls",
        "private per-user Kaggle jobs"
      ]
    },
    {
      "id": "T14",
      "priority": 14,
      "status": "complete",
      "objective": "Provide automatic local setup and easy cross-platform launching",
      "entry": [
        "launch.py",
        "run.bat",
        "run.sh"
      ],
      "acceptance": [
        "first-run environment setup",
        "repeat launches reuse existing service",
        "client requires no local GPU",
        "no credentials embedded"
      ]
    },
    {
      "id": "T15",
      "priority": 15,
      "status": "complete",
      "objective": "Review current implementation and Claude metadata, fix confirmed validation defects, and push reviewed UI refinements",
      "entry": [
        "docs/IMPLEMENTATION_REVIEW.md",
        "mm_emotion/experiment_inputs.py"
      ],
      "acceptance": [
        "metadata audit recorded",
        "distinct training pairs and leakage guarded",
        "branch/tag preflight pins immutable revision",
        "focused and full CPU tests pass",
        "notebook source verified"
      ]
    },
    {
      "id": "T16",
      "priority": 16,
      "status": "complete_cpu_ui",
      "objective": "Provide access to the running lab and an Anthropic-inspired example CSV",
      "entry": [
        "docs/ANTHROPIC_PILOT.md",
        "data/templates/anthropic_emotion_pilot.csv",
        "mm_emotion/integrated_ui.py"
      ],
      "acceptance": [
        "CSV passes existing validation",
        "training and testing scenarios separate",
        "paper source and adaptation differences disclosed",
        "built-in research and original course presets work",
        "Kaggle credential checked without submitting a run"
      ]
    }
  ]
}
